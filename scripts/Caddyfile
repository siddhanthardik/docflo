# ==============================================================================
# Gyrex Production Caddyfile (docflo on port 5008)
# Location on VPS: /etc/caddy/Caddyfile
# ==============================================================================

{
    on_demand_tls {
        ask http://127.0.0.1:5008/api/websites/verify-domain
    }
}

# 1. Main Platform Domain & www
gyrex.in, www.gyrex.in {
    reverse_proxy 127.0.0.1:5008
}

# 2. Automated On-Demand TLS for ALL Subdomains (*.gyrex.in) & Custom Domains
:443 {
    tls {
        on_demand
    }
    reverse_proxy 127.0.0.1:5008
}
